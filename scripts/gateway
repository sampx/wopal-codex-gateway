#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN="$ROOT/bin/wopal-codex-gateway"

usage() {
  cat <<'USAGE'
Usage: scripts/gateway <command>

Proxy service:
  start              Start the installed proxy service
  stop               Stop the proxy service without changing Codex config
  restart            Restart the proxy service
  status             Show install/load/health status
  service install    Install LaunchAgent autostart and start proxy
  service uninstall  Unload and remove LaunchAgent autostart

Codex integration:
  install            Install/enable the gateway in Codex
  disable            Restore pre-install Codex config and unload the gateway

Wopal AI models and auth:
  models list        List models visible to the Wopal AI API key
  models sync        Import all Codex-usable Wopal AI models
  models add <name...>     Add one or more Wopal AI models locally
  models set <name...>     Update context/vision/reasoning metadata
  models remove <name...>  Remove one or more Wopal AI models locally
  auth set           Store and validate the Wopal AI API key
  auth test          Validate the stored Wopal AI API key
  auth status        Show whether a key is configured

External providers (add --provider <id> after the model names where relevant):
  providers set <id> --base-url <url> [--base-url-for <protocol>=<url>]...
                     [--models-url <url>] [--models-auth none|provider-key]
                     [--header <name>=<value>]... [--protocol <default>]
                     [--tool-mode direct|code_mode|code_mode_only]
  providers remove <id>            Remove an unreferenced external provider
  auth set --provider <id>         Store and validate a provider API key
  auth test --provider <id>        Validate the stored provider API key
  auth status --provider <id>      Show whether the provider key is configured
  models sync --provider <id>      Refresh an external provider's model metadata
  models add <model...> --provider <id> [--protocol <protocol>] [--alias <name>]
  models set <model...> --provider <id> [metadata options]
  models remove <model...> --provider <id>

Low-level passthrough:
  config ...         Run a gateway config command
  catalog refresh    Rebuild model catalog
  quota ...          Quota learning state, e.g. quota reset-learning
  codex ...          Raw codex subcommands, e.g. codex install / codex restore

Every command accepts -h / --help.
USAGE
}

die() { echo "error: $*" >&2; exit 1; }

require_bin() {
  [[ -x "$BIN" ]] || die "built gateway binary not found at $BIN; run 'go build -o bin/wopal-codex-gateway ./cmd/gateway'"
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  start|stop|restart|status)
    require_bin
    exec "$BIN" service "$cmd" "$@"
    ;;
  install)
    require_bin
    "$BIN" codex install "$@"
    echo "Restart ChatGPT/Codex Desktop manually to reload the model catalog."
    ;;
  disable)
    require_bin
    "$BIN" codex restore "$@"
    echo "Restart ChatGPT/Codex Desktop manually to reload the original configuration."
    ;;
  models|service|auth|config|catalog|providers|quota|codex)
    require_bin
    exec "$BIN" "$cmd" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

